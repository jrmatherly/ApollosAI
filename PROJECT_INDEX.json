  "patterns": [
    "Registry (agent self-registration, IntegrationRegistry)",
    "Pub-Sub (EventStream central hub)",
    "Factory (storage/runtime selection)",
    "Strategy (condenser implementations)",
    "Query/Mutation (TanStack data layer)",
    "Type Guards (40+ event predicates)",
    "Replay Protection (OrderedDict dedup cache, instance-level)",
    "Payload Sanitization (sensitive key redaction)",
    "Fail-Closed Webhooks (missing secrets reject by default)",
    "ApollosAI Mode (isSaasMode && !isBillingEnabled)"
