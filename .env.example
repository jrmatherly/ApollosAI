# ── Database ──
# PostgreSQL connection string (postgres:// auto-converted to postgresql+asyncpg://)
# DATABASE_URL = "postgresql+asyncpg://user:pass@localhost:5432/apollosai"
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/openhands

# ── Encryption (generate a unique key) ──
# Master key for AES-256-GCM field encryption
# Generate with: `openssl rand -base64 32`
APOLLOSAI_ENCRYPTION_KEY=$(openssl rand -base64 32)
#APOLLOSAI_ENCRYPTION_KEY = ""

# ── JWT Session Signing (generate a unique secret) ──
# JWT signing secret (minimum 32 characters)
# Generate with: `openssl rand -hex 32`
JWT_SECRET=$(openssl rand -hex 32)

# ── Entra ID (Azure AD) ──
# Microsoft Entra ID (Azure AD) tenant identifier
# ENTRA_TENANT_ID=your-tenant-id

# OAuth2 application (client) ID
# ENTRA_CLIENT_ID=your-client-id

# OAuth2 client secret
# ENTRA_CLIENT_SECRET=your-client-secret

# OAuth2 redirect URI
# ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/callback
# ENTRA_REDIRECT_URI=https://app.example.com/api/auth/callback

# --- Optional ---
# Separate secret for Starlette SessionMiddleware (defaults to JWT_SECRET)
# SESSION_SECRET = ""

# Path to built frontend static files
# FRONTEND_DIRECTORY = "./frontend/dist"

# ── CORS (frontend dev server) ──
# Comma-separated allowed CORS origins
APOLLOSAI_CORS_ORIGINS=http://localhost:3001

# ── Dev Mode (skip auth for local testing) ──
# Allow unauthenticated access (dev only, parsed strictly: '1', 'true', 'yes')
# APOLLOSAI_ALLOW_UNAUTHENTICATED=false
APOLLOSAI_ALLOW_UNAUTHENTICATED=1

# ── OpenHands Config ──
# Automatically set by the entrypoint, but can be overridden:
# OPENHANDS_CONFIG_CLS=apollosai.server.config.ApollosAIServerConfig
