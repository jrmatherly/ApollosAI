# =============================================================================
# ApollosAI Docker Compose Environment Configuration
# =============================================================================
#
# WARNING: Copy this file to .env and fill in all CHANGE_ME values.
# Never commit .env — it contains secrets. Only .env.example is tracked in git.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker compose up -d
#
# =============================================================================

# -----------------------------------------------------------------------------
# App Config
# -----------------------------------------------------------------------------
APP_DISPLAY_NAME=ApollosAI
APP_MODE=saas

# LLM provider configuration (required)
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# -----------------------------------------------------------------------------
# Auth (Microsoft Entra ID)
# -----------------------------------------------------------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# JWT signing secret (minimum 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_BEFORE_PRODUCTION

# Session signing secret (separate from JWT)
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_BEFORE_PRODUCTION

# Set to true only for local development without Entra ID
APOLLOSAI_ALLOW_UNAUTHENTICATED=false

# -----------------------------------------------------------------------------
# Database (PostgreSQL 18 + pgvector)
# -----------------------------------------------------------------------------
POSTGRES_USER=apollosai

# REQUIRED: Set a strong password. Do NOT use the default in production.
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION

POSTGRES_DB=apollosai

# NOTE: This URL uses Docker Compose service hostname 'postgres'.
# Adjust for non-Docker deployments (e.g., localhost or external DB hostname).
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# Database Connection Pool
# -----------------------------------------------------------------------------
# Default SQLAlchemy async pool is only 5 connections — insufficient for AI
# workloads that hold connections during long-running LLM API calls.
SQLALCHEMY_POOL_SIZE=20
SQLALCHEMY_MAX_OVERFLOW=30
SQLALCHEMY_POOL_RECYCLE=1800

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# REQUIRED: Set a strong password for Redis authentication.
REDIS_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION

REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# -----------------------------------------------------------------------------
# Encryption
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
APOLLOSAI_ENCRYPTION_KEY=CHANGE_ME_BEFORE_PRODUCTION

# -----------------------------------------------------------------------------
# OpenTelemetry
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_SERVICE_NAME=apollosai

# -----------------------------------------------------------------------------
# Docker / Sandbox
# -----------------------------------------------------------------------------
SANDBOX_RUNTIME_CONTAINER_IMAGE=
WORKSPACE_BASE=./workspace

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin

# REQUIRED: Change before production use. Default 'admin' is insecure.
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION
